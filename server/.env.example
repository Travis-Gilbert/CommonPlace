# CommonPlace fork Express identity and ingest peer.
# Values are examples only. Never commit real credentials.

PORT=3001

# Real PostgreSQL only. Runtime traffic uses PgBouncer. Migration traffic uses
# the direct connection to the same database.
IDENTITY_DATABASE_URL=postgresql://user:password@pgbouncer.internal:6432/commonplace
IDENTITY_DIRECT_DATABASE_URL=postgresql://user:password@postgres.internal:5432/commonplace
IDENTITY_TOKEN_PEPPER=

# Shared only with the Console server-side proxy.
# Minimum 32 characters. Placeholder values are refused at startup.
COMMONPLACE_FORK_SERVER_INTERNAL_KEY=
# Comma-separated verified provider logins granted the admin overview.
COMMONPLACE_ADMIN_LOGINS=

# Parse-only collector peer.
COMMONPLACE_COLLECTOR_URL=http://collector.internal:8888
COMMONPLACE_COLLECTOR_PEER_TOKEN=

# Current HTTP seam into IngestPipeline. Production stays fail-closed until
# the target enforces tenant, workspace, and ScopeRef headers.
COMMONPLACE_CONTENT_TRANSPORT=graphql
COMMONPLACE_CONTENT_GRAPHQL_URL=http://commonplace-api.internal:50090/graphql
COMMONPLACE_CONTENT_API_KEY=
# Local single-scope development only. Never set on a shared production store.
# COMMONPLACE_UNSAFE_ALLOW_UNSCOPED_GRAPHQL=1
