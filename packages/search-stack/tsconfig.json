{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@commonplace/block-view-contracts/search-stack": [
        "../block-view-contracts/src/search-stack.ts"
      ],
      "@commonplace/block-view-contracts/search-stack-fixture": [
        "../block-view-contracts/src/search-stack-fixture.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"]
}
