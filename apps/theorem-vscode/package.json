{
  "name": "theorem-vscode",
  "displayName": "Theorem",
  "description": "The Theorem substrate inside the VS Code family: intelligence, local history, graph documents, spine search, and the agent.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "publisher": "commonplace",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.web.js",
  "activationEvents": ["onStartupFinished"],
  "enabledApiProposals": [
    "fileSearchProvider2",
    "textSearchProvider2",
    "timeline"
  ],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "Theorem",
      "properties": {
        "theorem.graphqlUrl": {
          "type": "string",
          "default": "https://commonplace-api-production.up.railway.app/graphql",
          "description": "The commonplace-api GraphQL door (editor intelligence). Override with THEOREM_EDITOR_GRAPHQL_URL."
        },
        "theorem.invalidationsUrl": {
          "type": "string",
          "default": "",
          "description": "Editor invalidation SSE door. Empty derives it from graphqlUrl (/v1/editor/invalidations); push is disabled only when neither resolves."
        },
        "theorem.projectId": {
          "type": "string",
          "default": "",
          "description": "Scopes the invalidation stream to one project (query param project_id). Empty receives every project the session can see."
        },
        "theorem.consoleOrigin": {
          "type": "string",
          "default": "https://v2.theoremharness.com",
          "description": "Console origin used for run and receipt deep links."
        },
        "theorem.agentUrl": {
          "type": "string",
          "default": "",
          "description": "ACP agent door (ws/http). Empty falls back to the console origin. Override with THEOREM_ACP_WS_URL."
        },
        "theorem.token": {
          "type": "string",
          "default": "",
          "description": "commonplace-api key (x-api-key). Prefer THEOREM_EDITOR_API_KEY env over settings.json in shared workspaces."
        }
      }
    },
    "commands": [
      { "command": "theorem.startSession", "title": "Theorem: Start Session", "category": "Theorem" },
      { "command": "theorem.openChat", "title": "Theorem: Open Chat", "category": "Theorem" },
      { "command": "theorem.applyFix", "title": "Theorem: Apply Fix", "category": "Theorem" },
      {
        "command": "theorem.sendSelectionToComposer",
        "title": "Theorem: Send Selection to Composer",
        "category": "Theorem"
      },
      {
        "command": "theorem.saveSelectionToGraph",
        "title": "Theorem: Save Selection to the Graph",
        "category": "Theorem"
      },
      { "command": "theorem.openRun", "title": "Theorem: Open Run in Console", "category": "Theorem" },
      { "command": "theorem.showHistory", "title": "Theorem: Show History", "category": "Theorem" },
      {
        "command": "theorem.diffRevision",
        "title": "Theorem: Compare Revision with Current",
        "category": "Theorem"
      },
      {
        "command": "theorem.restoreRevision",
        "title": "Theorem: Restore Revision",
        "category": "Theorem"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "theorem.applyFix", "when": "false" },
        { "command": "theorem.diffRevision", "when": "false" },
        { "command": "theorem.restoreRevision", "when": "false" },
        { "command": "theorem.openRun", "when": "false" }
      ],
      "timeline/item/context": [
        {
          "command": "theorem.restoreRevision",
          "when": "timelineItem == theorem.revision",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npx --yes -p typescript@5.7.3 tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gate:no-timers": "node scripts/check-no-timers.mjs"
  },
  "dependencies": {
    "@commonplace/block-view-contracts": "workspace:*",
    "@commonplace/theorem-acp": "workspace:*",
    "@commonplace/theorem-chat-register": "workspace:*",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  }
}
