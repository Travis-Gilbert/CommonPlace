COLLECTOR_BIND_HOST=127.0.0.1
COLLECTOR_PORT=8888
COLLECTOR_MAX_UPLOAD_BYTES=52428800
COLLECTOR_MAX_DOCUMENTS=32
COLLECTOR_MAX_EXTRACTED_TEXT_BYTES=16777216
COLLECTOR_MAX_RESPONSE_BYTES=20971520
COLLECTOR_PARSE_TIMEOUT_MS=60000
COLLECTOR_MAX_PARSER_WORKERS=2
# Required. Startup refuses an empty, placeholder, or short value.
COMMONPLACE_COLLECTOR_PEER_TOKEN=
# During rotation only; remove after every Express peer uses the current token.
# COMMONPLACE_COLLECTOR_PREVIOUS_PEER_TOKEN=

# Configure the Express peer separately.
# COMMONPLACE_COLLECTOR_URL=http://127.0.0.1:8888
# COMMONPLACE_COLLECTOR_PEER_TOKEN=the-current-service-secret
